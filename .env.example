SECRET_KEY_BASE=changeme_generate_with_mix_phx_gen_secret
# debug | info | warning | error (default: info en produccion)
LOG_LEVEL=info

# Conexiones a Mongo que mantiene notifications.
MONGO_POOL_SIZE=10
MONGO_URL=mongodb://localhost:27017/notifications_dev
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Puente a RabbitMQ por Tailscale (solo en la nube; vacio = el contenedor arranca directo).
# Con TS_AUTHKEY, RABBITMQ_URL apunta al puente local: amqp://USUARIO:CLAVE@127.0.0.1:5672
# TS_AUTHKEY=
# RABBITMQ_TS_HOST=100.115.4.88
# RABBITMQ_TS_PORT=5672
# RABBITMQ_LOCAL_PORT=5672
# TS_HOSTNAME=discordia-notifications
# En la nube: MONGO_URL=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/notifications?retryWrites=true&w=majority

# Origenes permitidos para el WebSocket (lista separada por comas, o false).
CHECK_ORIGIN=false

# Dias que se conserva el historial de notificaciones (0 = para siempre, default).
HISTORY_RETENTION_DAYS=0

# Notificaciones push. Sin VAPID_PRIVATE_KEY no se envian pushes web (la app sigue por Expo).
# Generar el par con: mix push.gen_vapid
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@discordia.example
# Opcional: token de acceso de Expo (seguridad reforzada) y URL de su API.
EXPO_ACCESS_TOKEN=
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Dispositivos maximos por usuario y servicios de push web aceptados (sufijos de host).
# PUSH_MAX_DEVICES=10
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
